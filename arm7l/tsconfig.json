{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@opencode-ai/*": ["../../packages/*/src"],
      "bun:*": ["./shims/bun-shim.ts"]
    },
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*", "shims/**/*"],
  "exclude": ["node_modules", "dist", "test"],
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  }
}
